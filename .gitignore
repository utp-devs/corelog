# =====================================================================
# Corelog — repository-wide ignore rules
# Organised by toolchain. Keep this file sorted by section, not by age.
# =====================================================================

# ---------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------

# Build output: the default binary name, /bin/ and shared-library formats
/corelog
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and compiler output
*.test
*.out
*.cov
*.cover

# Coverage reports
coverage.out
coverage.html
coverage/
htmlcov/

# Runtime and profiling artifacts
*.prof
*.pprof
*.trace
__debug_bin*
debug

# Go workspace files (the module is defined by go.mod, not go.work)
go.work
go.work.sum

# Scratch directory
/tmp/

# ---------------------------------------------------------------------
# Local data stores
# ---------------------------------------------------------------------
/data/
*.db
*.db-journal
*.db-shm
*.db-wal

# ---------------------------------------------------------------------
# Secrets and machine-local configuration
# Never commit real values; .env.example stays tracked as the template.
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.crt
*.cer
*.jks
*.p8
*.kdbx
secrets/
secrets.json
*.secret
secrets.*.json
credentials.json
.netrc
.npmrc
id_rsa
id_ed25519
id_ecdsa
# Local test accounts list with passwords (never versioned)
/users.txt
# Browser storage states and auth tokens captured by Playwright
**/playwright/.auth/

# ---------------------------------------------------------------------
# Node.js, npm and Vite (see web/.gitignore for the frontend-specific set)
# ---------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
.pnp.*

# Build output
dist/
dist-ssr/
.vite/
.next/
.nuxt/
/build/
/target/
/out/
*.o
*.a

# Installed dependencies vendored outside node_modules and Go vendoring
vendor/
packages/

# Caches
.cache/
.eslintcache
.stylelintcache
.npm/
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------
*.log
logs/
*.session.log
*.transcript

# ---------------------------------------------------------------------
# Memory dumps, temporary and backup files
# ---------------------------------------------------------------------
*.dmp
*.hprof
*.tmp
*.temp
*.bak
*.orig
*.rej

# ---------------------------------------------------------------------
# Database dumps and backups (migrations under migrations/ stay tracked)
# ---------------------------------------------------------------------
*.dump
*.sqldump
*.backup
*.sql.gz
*_dump.sql
dump*.sql
backups/

# ---------------------------------------------------------------------
# Playwright artifacts (screenshots of failed runs, traces, HTML report)
# ---------------------------------------------------------------------
/web/test-results/
/web/playwright-report/
/web/blob-report/
/web/playwright/.cache/

# ---------------------------------------------------------------------
# Python tooling (scripts/ with uv-managed virtualenv)
# ---------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-*
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# Packaging and Docker overrides
# ---------------------------------------------------------------------
/corelog-package.tar.gz
/corelog-package.zip
docker/**/*.local.yml
docker-compose.local.yml

# ---------------------------------------------------------------------
# AI coding agents: instructions, planning documents, local state
# Never versioned. Shared project rules live in the tracked docs and in
# the commit conventions; these folders are personal to each contributor.
# ---------------------------------------------------------------------
# Claude Code (project instructions, rules, settings, local memory)
.claude/
.claude.json
CLAUDE.md
CLAUDE.local.md
# Planning and working documents for agents
.agents/
# Generic agent instruction files
AGENTS.md
GEMINI.md
.cursorrules
.github/copilot-instructions.md
# Editor and assistant configuration folders
.cursor/
.windsurf/
.continue/
.codex/
.cline/
.roo/
.gemini/
.kiro/
.opencode/
.trae/
.copilot/
.aider*
# MCP client configuration (often holds tokens or local paths)
.mcp.json
# Worktrees and session state created by coding agents
.claude-flow/
.swarm/
*.agent-session

# Private working material (not versioned)
/.images/
/pinterest/

# Files written by the import tests
/cmd/api/data/
