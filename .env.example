APP_ENV=development
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=15s
CORS_ALLOWED_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=corelog
DB_USER=corelog
DB_PASSWORD=corelog
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

JWT_SECRET=change-me-in-production
JWT_EXPIRATION=24h

# Clave de cifrado de los secretos de 2FA: 32 bytes aleatorios en base64 (openssl rand -base64 32).
# Obligatoria fuera de APP_ENV=development; en desarrollo se deriva del secreto JWT.
TWO_FACTOR_ENCRYPTION_KEY=

# --- Seguridad, red y retención (ver docs/despliegue.md para la guía de producción) ---
# Origenes permitidos por CORS, separados por comas. Tiene prioridad sobre CORS_ALLOWED_ORIGIN.
CORS_ALLOWED_ORIGINS=
# URL pública del frontend; se usa en los enlaces de los correos (recuperación, verificación, resumen).
APP_PUBLIC_URL=http://localhost:5173
# URL pública base para los enlaces de invitaciones y del calendario (feed ICS).
PUBLIC_URL=
# Clave AES de 32 bytes en base64 que cifra los secretos de los webhooks (openssl rand -base64 32).
# Sin ella se deriva de JWT_SECRET y se registra un aviso. Obligatoria en producción por buena práctica.
APP_ENCRYPTION_KEY=
# Correo saliente. Sin SMTP_HOST los correos solo se escriben en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CoreLog <no-reply@localhost>
# Exigir correo verificado para iniciar sesión.
REQUIRE_EMAIL_VERIFICATION=false
# Límites de frecuencia (se ignora RATE_LIMIT_DISABLED cuando APP_ENV=production).
RATE_LIMIT_DISABLED=false
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_FORGOT_PER_HOUR=5
RATE_LIMIT_PHONE_PER_HOUR=10
API_TOKEN_RATE_LIMIT_PER_MIN=600
# Bloqueo de cuenta por intentos fallidos.
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION=15m
# Direcciones o CIDR de los proxies cuyo X-Forwarded-For se acepta, separados por comas.
TRUSTED_PROXIES=
# Cabecera Strict-Transport-Security (solo detrás de TLS).
HSTS_ENABLED=false
# Días de conservación de la auditoría.
AUDIT_RETENTION_DAYS=365
# Tamaño máximo del cuerpo JSON, en bytes.
MAX_JSON_BODY_BYTES=1048576
# Cuándo se envía el resumen diario por correo.
EMAIL_DIGEST_SCHEDULE=daily at 08:00 UTC
# Depuración de elementos eliminados (30 días). PURGE_DRY_RUN=true solo registra lo que borraría.
PURGE_ENABLED=false
PURGE_DRY_RUN=true
# Permitir webhooks hacia direcciones privadas o locales (se ignora en producción).
WEBHOOK_ALLOW_PRIVATE=false
# Carpetas de archivos adjuntos e importaciones CSV.
ATTACHMENTS_DIR=data/attachments
IMPORTS_DIR=data/imports
# Tareas en segundo plano (correo, resumen, suscripciones, depuración). false las desactiva.
JOBS_ENABLED=true
# Documentos legales: warn solo avisa; block responde 403 hasta aceptar.
LEGAL_ENFORCEMENT=warn

# --- Solo para cmd/seed (nunca en producción) ---
# SEED_PASSWORD=            contraseña de las cuentas sembradas (obligatoria, sin valor por defecto)
# SEED_ALLOW_DATA_LOSS=yes  permite --force-reset sobre una base con cuentas reales
