/var/log/nginx/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    sharedscripts
    postrotate
        docker exec nginx nginx -s reopen >/dev/null 2>&1 || true
    endscript
}

# ModSecurity keeps its own file descriptor open: truncate in place instead of reopen
/var/log/modsec_audit.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
