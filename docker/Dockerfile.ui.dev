# syntax=docker/dockerfile:1
# Imagen de desarrollo de la UI: servidor de Vite con recarga en caliente.
# El codigo fuente llega por volumen (docker-compose.dev.yaml), no se copia aqui.

FROM node:24-alpine
WORKDIR /app

# Dependencias instaladas dentro del contenedor (los binarios del host no sirven en Linux).
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --ignore-scripts

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
